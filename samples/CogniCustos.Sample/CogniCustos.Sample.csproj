<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The small runnable sample: the shell from CogniCustos.Ui, wired to the real
    runtime in CogniCustos.Core. Nothing here is a product; the point is to feel
    the whole flow (line -> cards -> confirm -> SQLite) in one window.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CogniCustos.Sample</RootNamespace>
    <AssemblyName>CogniCustos.Sample</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CogniCustos.Ui\CogniCustos.Ui.csproj" />
    <ProjectReference Include="..\..\src\CogniCustos.Core\CogniCustos.Core.csproj" />
    <ProjectReference Include="..\..\src\CogniCustos.Adapters\CogniCustos.Adapters.csproj" />
    <ProjectReference Include="..\..\src\CogniCustos.Contracts\CogniCustos.Contracts.csproj" />
  </ItemGroup>

</Project>
