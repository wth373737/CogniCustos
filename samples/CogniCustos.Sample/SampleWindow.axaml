<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:CogniCustos.Ui.Views"
        x:Class="CogniCustos.Sample.SampleWindow"
        Title="CogniCustos — Sample"
        Width="1280" Height="720"
        MinWidth="1024" MinHeight="576"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}"
        FontFamily="{StaticResource UiFont}">

  <!-- Same 1280x720 shell as the sandbox, this time on top of the real runtime. -->
  <Viewbox Stretch="Uniform" StretchDirection="Both"
           HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <views:ShellView Width="1280" Height="720" />
  </Viewbox>

</Window>
