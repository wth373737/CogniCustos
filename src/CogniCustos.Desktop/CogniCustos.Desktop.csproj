<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CogniCustos.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CogniCustos.Contracts\CogniCustos.Contracts.csproj" />
    <ProjectReference Include="..\CogniCustos.Core\CogniCustos.Core.csproj" />
    <ProjectReference Include="..\CogniCustos.Adapters\CogniCustos.Adapters.csproj" />
  </ItemGroup>
</Project>
