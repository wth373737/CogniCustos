<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CogniCustos.Ui.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CogniCustos.Ui/Styles/Tokens.axaml" />
        <!-- index 1: Localizer swaps this one when the language changes -->
        <ResourceInclude Source="avares://CogniCustos.Ui/Resources/Lang.en.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://CogniCustos.Ui/Styles/Controls.axaml" />
  </Application.Styles>

</Application>
