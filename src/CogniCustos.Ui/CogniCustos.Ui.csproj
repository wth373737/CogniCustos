<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-only project. It deliberately references NO Core / Adapters project:
    the whole point of this sandbox is that the shell can be built, run and
    debugged on its own, with mock data, before it is wired to the runtime.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CogniCustos.Ui</RootNamespace>
    <AssemblyName>CogniCustos.Ui</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

</Project>
