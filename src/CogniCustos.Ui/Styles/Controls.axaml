<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== flat icon button ===== -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14000000" />
  </Style>

  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1F000000" />
  </Style>

  <Style Selector="Button.icon.open /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FFE7E5F4" />
  </Style>

  <!-- ===== the glyph itself ===== -->
  <Style Selector="TextBlock.glyph">
    <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!-- ===== drawer tile (icon grid) ===== -->
  <Style Selector="Button.tile">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Width" Value="60" />
    <Setter Property="Height" Value="62" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.tile /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1AFFFFFF" />
  </Style>

  <!-- ===== card ===== -->
  <Style Selector="Border.card">
    <Setter Property="Width" Value="300" />
    <Setter Property="Height" Value="300" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16,14,16,10" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BoxShadow" Value="0 6 20 0 #0E000000" />
  </Style>

  <Style Selector="Border.card.pink">
    <Setter Property="Background" Value="{DynamicResource CardPink}" />
  </Style>

  <Style Selector="Border.card.olive">
    <Setter Property="Background" Value="{DynamicResource CardOlive}" />
  </Style>

  <!-- ===== settings navigation ===== -->
  <Style Selector="ListBox.settings">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.settings ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="ListBox.settings ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FFEFEDF8" />
  </Style>

  <Style Selector="ListBox.settings ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <!-- ===== plain text button ===== -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#12000000" />
  </Style>

  <!-- ===== language pill ===== -->
  <Style Selector="Button.lang">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.lang /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.lang:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#12000000" />
  </Style>

  <!-- ===== text helpers ===== -->
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#FF3B3B47" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
  </Style>

  <!-- ===== input pill ===== -->
  <Style Selector="TextBox.pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

</Styles>
