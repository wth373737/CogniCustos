<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ Palette (sampled from the sketch) ============ -->
  <Color x:Key="AppBgColor">#FFF2F2F7</Color>
  <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
  <Color x:Key="SidebarColor">#FFEBEBEF</Color>
  <Color x:Key="RailColor">#FFE7E4F0</Color>
  <Color x:Key="DrawerColor">#FFECEAF6</Color>
  <Color x:Key="CardCalendarColor">#FFEEEEEF</Color>
  <Color x:Key="CardPinkColor">#FFFCE8EA</Color>
  <Color x:Key="CardOliveColor">#FFF0EFDF</Color>
  <Color x:Key="ChipColor">#FFE3E3E3</Color>
  <Color x:Key="InkColor">#FF23232B</Color>
  <Color x:Key="InkSoftColor">#FF6B6B79</Color>
  <Color x:Key="InkFaintColor">#FF9A9AA7</Color>
  <Color x:Key="LineColor">#FFECECF1</Color>

  <SolidColorBrush x:Key="AppBg" Color="{StaticResource AppBgColor}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SidebarBg" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="RailBg" Color="{StaticResource RailColor}" />
  <SolidColorBrush x:Key="DrawerBg" Color="{StaticResource DrawerColor}" />
  <SolidColorBrush x:Key="CardCalendar" Color="{StaticResource CardCalendarColor}" />
  <SolidColorBrush x:Key="CardPink" Color="{StaticResource CardPinkColor}" />
  <SolidColorBrush x:Key="CardOlive" Color="{StaticResource CardOliveColor}" />
  <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}" />
  <!-- calendar window (from the calendar mock) -->
  <Color x:Key="CalendarBgColor">#FFF7F0F7</Color>
  <Color x:Key="CalendarHeadColor">#FFA9C5E9</Color>
  <Color x:Key="CalendarCellColor">#FFE9F5FA</Color>
  <Color x:Key="CalendarAgendaColor">#FFEAF7D9</Color>
  <Color x:Key="CalendarLineColor">#FF6F6F6F</Color>
  <Color x:Key="CalendarInkColor">#FF2E2E33</Color>
  <Color x:Key="CalendarInkFaintColor">#FF9A9AA3</Color>
  <Color x:Key="CalendarTodayColor">#FFBFDCF2</Color>
  <SolidColorBrush x:Key="CalendarBg" Color="{StaticResource CalendarBgColor}" />
  <SolidColorBrush x:Key="CalendarHead" Color="{StaticResource CalendarHeadColor}" />
  <SolidColorBrush x:Key="CalendarCell" Color="{StaticResource CalendarCellColor}" />
  <SolidColorBrush x:Key="CalendarAgenda" Color="{StaticResource CalendarAgendaColor}" />
  <SolidColorBrush x:Key="CalendarLine" Color="{StaticResource CalendarLineColor}" />
  <SolidColorBrush x:Key="CalendarInk" Color="{StaticResource CalendarInkColor}" />
  <SolidColorBrush x:Key="CalendarInkFaint" Color="{StaticResource CalendarInkFaintColor}" />
  <SolidColorBrush x:Key="CalendarToday" Color="{StaticResource CalendarTodayColor}" />

  <!-- reminder drawer surface: change the alpha here to make it more/less transparent -->
  <SolidColorBrush x:Key="ReminderDrawerBackground" Color="#F2FFFFFF" />
  <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkSoft" Color="{StaticResource InkSoftColor}" />
  <SolidColorBrush x:Key="InkFaint" Color="{StaticResource InkFaintColor}" />
  <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />

  <!-- ============ Typography ============ -->
  <!-- the raw thought trace: monospace first, CJK fallback after it -->
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI, Segoe UI</FontFamily>

  <FontFamily x:Key="UiFont">Inter, Microsoft YaHei UI, Segoe UI</FontFamily>
  <!-- Windows icon font. Segoe MDL2 Assets ships on Win10/11, Fluent Icons on Win11. -->
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- ============ Icon glyphs (MDL2 code points) ============ -->
  <x:String x:Key="GlyphMenu">&#xE700;</x:String>
  <x:String x:Key="GlyphHelp">&#xE897;</x:String>
  <x:String x:Key="GlyphSettings">&#xE713;</x:String>
  <x:String x:Key="GlyphSearch">&#xE721;</x:String>
  <x:String x:Key="GlyphVolume">&#xE767;</x:String>
  <x:String x:Key="GlyphCalendar">&#xE787;</x:String>
  <x:String x:Key="GlyphTasks">&#xE9D5;</x:String>
  <x:String x:Key="GlyphNote">&#xE70F;</x:String>
  <x:String x:Key="GlyphKnowledge">&#xE8F1;</x:String>
  <x:String x:Key="GlyphSandbox">&#xE9D5;</x:String>
  <x:String x:Key="GlyphAttach">&#xE723;</x:String>
  <x:String x:Key="GlyphFolder">&#xE8B7;</x:String>
  <x:String x:Key="GlyphMail">&#xE715;</x:String>
  <x:String x:Key="GlyphPerson">&#xE77B;</x:String>
  <x:String x:Key="GlyphAlarm">&#xE7ED;</x:String>
  <x:String x:Key="GlyphDoc">&#xE8A5;</x:String>
  <x:String x:Key="GlyphChat">&#xE8BD;</x:String>
  <x:String x:Key="GlyphChevronDown">&#xE70D;</x:String>
  <x:String x:Key="GlyphChevronUp">&#xE70E;</x:String>
  <x:String x:Key="GlyphChevronLeft">&#xE76B;</x:String>
  <x:String x:Key="GlyphClose">&#xE711;</x:String>
  <x:String x:Key="GlyphChevronRight">&#xE76C;</x:String>
  <x:String x:Key="GlyphPlus">&#xE710;</x:String>
  <x:String x:Key="GlyphGlobe">&#xE774;</x:String>
  <x:String x:Key="GlyphMic">&#xE720;</x:String>
  <x:String x:Key="GlyphBack">&#xE72B;</x:String>
  <x:String x:Key="GlyphList">&#xE8FD;</x:String>
  <x:String x:Key="GlyphCheck">&#xE73E;</x:String>

  <!-- Database cylinder drawn by hand: MDL2 has no database glyph. -->
  <StreamGeometry x:Key="GeoDataBase">M2,4.5 A7,2.6 0 1 0 16,4.5 A7,2.6 0 1 0 2,4.5 M2,4.5 V13.5 A7,2.6 0 0 0 16,13.5 V4.5 M2,9 A7,2.6 0 0 0 16,9</StreamGeometry>

</ResourceDictionary>
