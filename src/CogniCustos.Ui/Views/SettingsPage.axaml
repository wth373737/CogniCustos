<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CogniCustos.Ui.ViewModels"
             xmlns:views="using:CogniCustos.Ui.Views"
             x:Class="CogniCustos.Ui.Views.SettingsPage"
             x:DataType="vm:ShellViewModel"
             Background="{StaticResource AppBg}"
             ClipToBounds="True">

  <UserControl.Resources>
    <!-- one labelled value row; double-click (or the pencil) starts editing -->
    <DataTemplate x:Key="ModelFieldRow" x:DataType="vm:ModelField">
      <Grid ColumnDefinitions="150,*" Margin="0,0,0,7">
        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5"
                   Foreground="#FF3C4A47" VerticalAlignment="Center" />
        <Border Grid.Column="1" Height="30" Background="White" CornerRadius="4"
                BorderBrush="#FFCFDAD7" BorderThickness="1"
                DoubleTapped="OnFieldDoubleTapped">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                       Text="{Binding DisplayValue}" IsVisible="{Binding IsReadOnly}"
                       Foreground="#FF2B2B32" TextTrimming="CharacterEllipsis" />
            <TextBox Grid.Column="0" Margin="2" Padding="6,2" FontSize="12.5"
                     Background="Transparent" BorderThickness="0"
                     Text="{Binding EditText, Mode=TwoWay}" IsVisible="{Binding IsEditing}"
                     KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" />
            <Button Grid.Column="1" Width="26" Height="26" Classes="fieldPencil" Margin="0,0,2,0"
                    Command="{Binding BeginEditCommand}">
              <TextBlock Classes="glyph" Text="&#xE70F;" FontSize="11" Foreground="#FF6D7C79" />
            </Button>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="84,*,Auto">

    <!-- header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="30,0,22,0">
      <TextBlock Grid.Column="0" Classes="glyph" Text="{StaticResource GlyphSettings}" FontSize="26"
                 Foreground="{StaticResource Ink}" />
      <TextBlock Grid.Column="1" Text="{DynamicResource Settings.Title}" FontSize="26" FontWeight="SemiBold"
                 Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Ink}" />
      <views:LanguagePicker Grid.Column="3" VerticalAlignment="Center" />
    </Grid>

    <!-- body: section list + content -->
    <Grid Grid.Row="1" ColumnDefinitions="280,*" Margin="30,0,22,0">

      <ListBox Grid.Column="0" Classes="settings" Margin="0,0,18,0"
               ItemsSource="{Binding Settings.Sections}"
               SelectedItem="{Binding Settings.Selected, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsSectionViewModel">
            <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="1" CornerRadius="14" Background="#FFE7EFED" Padding="26,22">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Grid.Row="0" Text="{Binding Settings.SelectedTitle}" FontSize="20" FontWeight="SemiBold"
                     Foreground="#FF3C4A47" />
          <Border Grid.Row="1" Height="1" Background="#FFD7E2DF" Margin="0,12,0,0" />

          <TextBlock Grid.Row="2" Text="{DynamicResource Settings.Placeholder}" FontSize="15.5"
                     Foreground="#FF93A29F" Margin="0,16,0,0" TextWrapping="Wrap"
                     IsVisible="{Binding Settings.ShowPlaceholder}" />

          <!-- 界面配置: one button per interface piece, for looking at them later -->
          <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding Settings.ShowPreviewGallery}">
            <StackPanel Spacing="14">
              <TextBlock Text="{DynamicResource Appearance.Hint}" FontSize="14.5"
                         Foreground="#FF6D7C79" TextWrapping="Wrap" />
              <WrapPanel>
                <Button Classes="preview" Content="{DynamicResource Appearance.Home}"
                        Command="{Binding PreviewCommand}" CommandParameter="home" />
                <Button Classes="preview" Content="{DynamicResource Appearance.Reminder}"
                        Command="{Binding PreviewCommand}" CommandParameter="today-list" />
                <Button Classes="preview" Content="{DynamicResource Appearance.ReminderLong}"
                        Command="{Binding PreviewCommand}" CommandParameter="today-list-long" />
                <Button Classes="preview" Content="{DynamicResource Appearance.MenuDrawer}"
                        Command="{Binding PreviewCommand}" CommandParameter="drawer" />
                <Button Classes="preview" Content="{DynamicResource Appearance.FutureDrawer}"
                        Command="{Binding PreviewCommand}" CommandParameter="expanded" />
                <Button Classes="preview" Content="{DynamicResource Appearance.Language}"
                        Command="{Binding PreviewCommand}" CommandParameter="language-menu" />
                <Button Classes="preview" Content="{DynamicResource Appearance.Help}"
                        Command="{Binding PreviewCommand}" CommandParameter="help" />
                <Button Classes="preview" Content="{DynamicResource Appearance.Settings}"
                        Command="{Binding PreviewCommand}" CommandParameter="settings" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
          <!-- Model Configuration: the first real settings form -->
          <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding Settings.ShowModelConfiguration}">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding Settings.Model.PrimaryHeader}" FontSize="16.5" FontWeight="SemiBold"
                         Foreground="#FF3C4A47" />
              <ItemsControl ItemsSource="{Binding Settings.Model.Fields}"
                            ItemTemplate="{StaticResource ModelFieldRow}" />
              <TextBlock Text="{Binding Settings.Model.DocsNote}" FontSize="12" TextWrapping="Wrap"
                         Foreground="#FF6D7C79" />

              <Grid ColumnDefinitions="215,*" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Settings.Model.AdvancedLabel}" FontSize="13.5"
                             Foreground="#FF3C4A47" VerticalAlignment="Center" />
                  <Button Width="24" Height="22" Classes="chipGhost"
                          Command="{Binding Settings.Model.ToggleAdvancedCommand}">
                    <TextBlock Classes="glyph" Text="{Binding Settings.Model.AdvancedChevron}" FontSize="11"
                               Foreground="#FF3C4A47" />
                  </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Settings.Model.AdvancedNote}" FontSize="12"
                           TextWrapping="Wrap" Foreground="#FF6D7C79" />
              </Grid>

              <TextBlock Text="{Binding Settings.Model.LocalModelHeader}" FontSize="16.5" FontWeight="SemiBold"
                         Foreground="#FF3C4A47" Margin="0,6,0,0" />
              <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                <TextBlock Text="{Binding Settings.Model.LocalModelName}" FontSize="13" Margin="0,0,12,0"
                           Foreground="#FF2B2B32" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="chip" Margin="0,0,8,0"
                        Command="{Binding Settings.Model.CheckCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Settings.Model.CheckLabel}" FontSize="12.5" />
                    <TextBlock Classes="glyph" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="danger" Margin="0,0,14,0"
                        Content="{Binding Settings.Model.DeleteLabel}"
                        Command="{Binding Settings.Model.DeleteCommand}" />
                <TextBlock Grid.Column="3" Text="{Binding Settings.Model.LocalModelNote}" FontSize="12"
                           TextWrapping="Wrap" Foreground="#FF6D7C79" />
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding Settings.Model.OllamaLabel}" FontSize="13.5"
                           Foreground="#FF3C4A47" />
                <TextBlock Classes="glyph" Text="&#xE70D;" FontSize="10" Foreground="#FF3C4A47"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Settings.Model.OllamaNote}" FontSize="12" TextWrapping="Wrap"
                         Foreground="#FF6D7C79" />
              <Button Classes="wideAction" Content="{Binding Settings.Model.AddLabel}"
                      Command="{Binding Settings.Model.AddCommand}" Margin="0,4,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- footer -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,14,22,16">
      <Button Classes="icon" Width="30" Height="30" ToolTip.Tip="{DynamicResource Help.Title}">
        <TextBlock Classes="glyph" Text="{StaticResource GlyphHelp}" FontSize="18" />
      </Button>
      <Button Classes="icon" Width="30" Height="30" Command="{Binding ToggleSettingsCommand}"
              ToolTip.Tip="{DynamicResource Tip.Back}">
        <TextBlock Classes="glyph" Text="&#xE7A7;" FontSize="18" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
