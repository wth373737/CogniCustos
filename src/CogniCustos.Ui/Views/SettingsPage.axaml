<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CogniCustos.Ui.ViewModels"
             xmlns:views="using:CogniCustos.Ui.Views"
             x:Class="CogniCustos.Ui.Views.SettingsPage"
             x:DataType="vm:ShellViewModel"
             Background="{StaticResource AppBg}"
             ClipToBounds="True">

  <UserControl.Resources>
    <!-- one labelled value row; double-click (or the pencil) starts editing -->
    <DataTemplate x:Key="ModelFieldRow" x:DataType="vm:ModelField">
      <Grid ColumnDefinitions="150,*" Margin="0,0,0,7">
        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5"
                   Foreground="#FF3C4A47" VerticalAlignment="Center" />
        <Border Grid.Column="1" Height="30" Background="White" CornerRadius="4"
                BorderBrush="#FFCFDAD7" BorderThickness="1"
                DoubleTapped="OnFieldDoubleTapped">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                       Text="{Binding DisplayValue}" IsVisible="{Binding IsReadOnly}"
                       Foreground="#FF2B2B32" TextTrimming="CharacterEllipsis" />
            <TextBox Grid.Column="0" Margin="2" Padding="6,2" FontSize="12.5"
                     Background="Transparent" BorderThickness="0"
                     Text="{Binding EditText, Mode=TwoWay}" IsVisible="{Binding IsEditing}"
                     KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" />
            <Button Grid.Column="1" Width="26" Height="26" Classes="fieldPencil" Margin="0,0,2,0"
                    Command="{Binding BeginEditCommand}">
              <TextBlock Classes="glyph" Text="&#xE70F;" FontSize="11" Foreground="#FF6D7C79" />
            </Button>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="84,*,Auto">

    <!-- dim the page behind the configuration window -->
    <Border Grid.RowSpan="3" ZIndex="39" Background="#40000000"
            IsVisible="{Binding Settings.Model.IsOllamaWindowOpen}" />

    <!-- the Ollama configuration window: address fixed, model name typed -->
    <Border Grid.RowSpan="3" Width="470" Padding="24,20" Background="{StaticResource Surface}"
            CornerRadius="14" BoxShadow="0 18 44 0 #33000000"
            HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="40"
            IsVisible="{Binding Settings.Model.IsOllamaWindowOpen}">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding Settings.Model.OllamaTitleLabel}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource Ink}" />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Settings.Model.OllamaAddressLabel}"
                     FontSize="12.5" Foreground="#FF6D7C79" VerticalAlignment="Center" Margin="0,0,10,8" />
          <Border Grid.Row="0" Grid.Column="1" Height="28" Background="#FFF1F4F3" CornerRadius="4"
                  Margin="0,0,0,8">
            <TextBlock Text="{Binding Settings.Model.OllamaAddress}" FontSize="12.5" Margin="9,0,0,0"
                       Foreground="#FF6D7C79" VerticalAlignment="Center" />
          </Border>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Settings.Model.OllamaModelLabel}"
                     FontSize="12.5" Foreground="#FF6D7C79" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBox Grid.Row="1" Grid.Column="1" Height="30" FontSize="12.5" Padding="8,4"
                   Text="{Binding Settings.Model.OllamaModelText, Mode=TwoWay}"
                   Background="White" BorderBrush="#FFCFDAD7" BorderThickness="1" />
        </Grid>

        <TextBlock Text="{Binding Settings.Model.OllamaWindowNote}" FontSize="12" TextWrapping="Wrap"
                   Foreground="#FF6D7C79" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Classes="dialog" Content="{Binding Settings.Model.CancelLabel}"
                  Command="{Binding Settings.Model.CloseOllamaCommand}" />
          <Button Classes="dialog primary" Content="{Binding Settings.Model.OllamaEnableLabel}"
                  Command="{Binding Settings.Model.EnableOllamaCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>


    <!-- header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="30,0,22,0">
      <TextBlock Grid.Column="0" Classes="glyph" Text="{StaticResource GlyphSettings}" FontSize="26"
                 Foreground="{StaticResource Ink}" />
      <TextBlock Grid.Column="1" Text="{DynamicResource Settings.Title}" FontSize="26" FontWeight="SemiBold"
                 Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Ink}" />
      <views:LanguagePicker Grid.Column="3" VerticalAlignment="Center" />
    </Grid>

    <!-- body: section list + content -->
    <Grid Grid.Row="1" ColumnDefinitions="280,*" Margin="30,0,22,0">

      <ListBox Grid.Column="0" Classes="settings" Margin="0,0,18,0"
               ItemsSource="{Binding Settings.Sections}"
               SelectedItem="{Binding Settings.Selected, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsSectionViewModel">
            <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="1" CornerRadius="14" Background="#FFE7EFED" Padding="26,22">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Grid.Row="0" Text="{Binding Settings.SelectedTitle}" FontSize="20" FontWeight="SemiBold"
                     Foreground="#FF3C4A47" />
          <Border Grid.Row="1" Height="1" Background="#FFD7E2DF" Margin="0,12,0,0" />

          <TextBlock Grid.Row="2" Text="{DynamicResource Settings.Placeholder}" FontSize="15.5"
                     Foreground="#FF93A29F" Margin="0,16,0,0" TextWrapping="Wrap"
                     IsVisible="{Binding Settings.ShowPlaceholder}" />

          <!-- 界面配置: one button per interface piece, for looking at them later -->
          <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding Settings.ShowPreviewGallery}">
            <StackPanel Spacing="14">
              <TextBlock Text="{DynamicResource Appearance.Hint}" FontSize="14.5"
                         Foreground="#FF6D7C79" TextWrapping="Wrap" />
              <WrapPanel>
                <Button Classes="preview" Content="{DynamicResource Appearance.Home}"
                        Command="{Binding PreviewCommand}" CommandParameter="home" />
                <Button Classes="preview" Content="{DynamicResource Appearance.Reminder}"
                        Command="{Binding PreviewCommand}" CommandParameter="today-list" />
                <Button Classes="preview" Content="{DynamicResource Appearance.ReminderLong}"
                        Command="{Binding PreviewCommand}" CommandParameter="today-list-long" />
                <Button Classes="preview" Content="{DynamicResource Appearance.MenuDrawer}"
                        Command="{Binding PreviewCommand}" CommandParameter="drawer" />
                <Button Classes="preview" Content="{DynamicResource Appearance.FutureDrawer}"
                        Command="{Binding PreviewCommand}" CommandParameter="expanded" />
                <Button Classes="preview" Content="{DynamicResource Appearance.Language}"
                        Command="{Binding PreviewCommand}" CommandParameter="language-menu" />
                <Button Classes="preview" Content="{DynamicResource Appearance.Help}"
                        Command="{Binding PreviewCommand}" CommandParameter="help" />
                <Button Classes="preview" Content="{DynamicResource Appearance.Settings}"
                        Command="{Binding PreviewCommand}" CommandParameter="settings" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
          <!-- 邮件抓取配置: accounts, a form, and a real connection test -->
          <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding Settings.ShowEmailRetrieval}">
            <StackPanel Spacing="12">
              <TextBlock Text="{DynamicResource Settings.Email.Header}" FontSize="16.5" FontWeight="SemiBold"
                         Foreground="{StaticResource Ink}" />
              <TextBlock Text="{DynamicResource Settings.Email.Note}" FontSize="12.5"
                         Foreground="#FF6D7C79" TextWrapping="Wrap" />

              <Border Background="#FFEDF4F1" CornerRadius="8" Padding="14,12">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="{Binding Settings.EmailRetrieval.ThunderbirdHeader}"
                               FontSize="13.5" FontWeight="SemiBold" Foreground="#FF2B2B32"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="chip"
                            Content="{Binding Settings.EmailRetrieval.RescanLabel}"
                            Command="{Binding Settings.EmailRetrieval.RescanCommand}" />
                    <Button Grid.Column="2" Classes="chip"
                            Content="{Binding Settings.EmailRetrieval.UseThunderbirdLabel}"
                            Command="{Binding Settings.EmailRetrieval.ToggleThunderbirdCommand}"
                            ToolTip.Tip="{Binding Settings.EmailRetrieval.UseThunderbird}" />
                  </Grid>
                  <TextBlock Text="{Binding Settings.EmailRetrieval.ThunderbirdStatus}" FontSize="12.5"
                             Foreground="#FF3C4A47" />
                  <TextBlock Text="{Binding Settings.EmailRetrieval.ThunderbirdNote}" FontSize="12"
                             Foreground="#FF6D7C79" TextWrapping="Wrap" />

                  <TextBlock Text="{DynamicResource Settings.Email.Folders}" FontSize="12"
                             Foreground="#FF6D7C79" Margin="0,4,0,0"
                             IsVisible="{Binding Settings.EmailRetrieval.HasMailFolders}" />

                  <ItemsControl ItemsSource="{Binding Settings.EmailRetrieval.MailFolders}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                          <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12.5"
                                     Foreground="#FF2B2B32" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11.5"
                                     Foreground="#FF93A29F" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Button Classes="chipGhost" HorizontalAlignment="Left"
                      Content="{Binding Settings.EmailRetrieval.AdvancedLabel}"
                      Command="{Binding Settings.EmailRetrieval.ToggleAdvancedCommand}" />

              <ItemsControl ItemsSource="{Binding Settings.EmailRetrieval.Accounts}"
                            IsVisible="{Binding Settings.EmailRetrieval.AdvancedOpen}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{Binding Address}" FontSize="13" Foreground="#FF2B2B32" />
                        <TextBlock Text="{Binding Server}" FontSize="11.5" Foreground="#FF6D7C79" />
                        <TextBlock Text="{Binding Scope}" FontSize="11.5" Foreground="#FF93A29F" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"
                                 Foreground="#FF6D7C79" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Classes="chip" Content="{DynamicResource Settings.Email.Test}"
                                Command="{Binding TestCommand}" />
                        <Button Classes="danger" Content="{DynamicResource Settings.Email.Remove}"
                                Command="{Binding DeleteCommand}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding Settings.EmailRetrieval.EmptyNote}" FontSize="12.5"
                         Foreground="#FF93A29F" TextWrapping="Wrap"
                         IsVisible="{Binding !Settings.EmailRetrieval.HasAccounts}" />

              <Border Background="#FFF7FAF9" CornerRadius="8" Padding="14,12" Margin="0,6,0,0"
                      IsVisible="{Binding Settings.EmailRetrieval.AdvancedOpen}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{DynamicResource Settings.Email.Add}" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="#FF2B2B32" />
                  <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings.Email.Address}"
                               FontSize="12.5" Foreground="#FF6D7C79" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Height="28" FontSize="12.5"
                             Text="{Binding Settings.EmailRetrieval.Address, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings.Email.Server}"
                               FontSize="12.5" Foreground="#FF6D7C79" VerticalAlignment="Center" />
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,90" ColumnSpacing="6">
                      <TextBox Grid.Column="0" Height="28" FontSize="12.5"
                               Text="{Binding Settings.EmailRetrieval.Host, Mode=TwoWay}" />
                      <TextBox Grid.Column="1" Height="28" FontSize="12.5"
                               Text="{Binding Settings.EmailRetrieval.Port, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings.Email.Secret}"
                               FontSize="12.5" Foreground="#FF6D7C79" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Height="28" FontSize="12.5"
                             PasswordChar="•"
                             Text="{Binding Settings.EmailRetrieval.Secret, Mode=TwoWay}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings.Email.Days}"
                               FontSize="12.5" Foreground="#FF6D7C79" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <TextBox Width="70" Height="28" FontSize="12.5"
                               Text="{Binding Settings.EmailRetrieval.Days, Mode=TwoWay}" />
                      <CheckBox Content="{DynamicResource Settings.Email.UnreadOnly}" FontSize="12.5"
                                IsChecked="{Binding Settings.EmailRetrieval.UnreadOnly, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                      <Button Classes="chipGhost" Content="{DynamicResource Settings.Email.Import}"
                              Command="{Binding Settings.EmailRetrieval.ImportCommand}" />
                      <Button Classes="dialog primary" Content="{DynamicResource Settings.Email.AddButton}"
                              Command="{Binding Settings.EmailRetrieval.AddCommand}" />
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="{Binding Settings.EmailRetrieval.AddStatus}" FontSize="12"
                             Foreground="#FF3C4A47" TextWrapping="Wrap"
                             IsVisible="{Binding Settings.EmailRetrieval.HasAddStatus}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- 网页浏览配置: the pages the daily fetch reads -->
          <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding Settings.ShowWebBrowsing}">
            <StackPanel Spacing="12">
              <TextBlock Text="{DynamicResource Settings.Web.Header}" FontSize="16.5" FontWeight="SemiBold"
                         Foreground="{StaticResource Ink}" />
              <TextBlock Text="{DynamicResource Settings.Web.Note}" FontSize="12.5"
                         Foreground="#FF6D7C79" TextWrapping="Wrap" />

              <ItemsControl ItemsSource="{Binding Settings.WebBrowsing.Sources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{Binding Host}" FontSize="13" Foreground="#FF2B2B32" />
                        <TextBlock Text="{Binding Url}" FontSize="11.5" Foreground="#FF93A29F"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Access}" FontSize="11.5" Foreground="#FF6D7C79" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="danger" VerticalAlignment="Center"
                              Content="{DynamicResource Settings.Web.Remove}"
                              Command="{Binding DeleteCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding Settings.WebBrowsing.EmptyNote}" FontSize="12.5"
                         Foreground="#FF93A29F" TextWrapping="Wrap"
                         IsVisible="{Binding !Settings.WebBrowsing.HasSources}" />

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                <TextBox Grid.Column="0" Height="30" FontSize="12.5"
                         Watermark="{DynamicResource Settings.Web.Watermark}"
                         Text="{Binding Settings.WebBrowsing.NewUrl, Mode=TwoWay}" />
                <Button Grid.Column="1" Classes="dialog primary" Content="{DynamicResource Settings.Web.Add}"
                        Command="{Binding Settings.WebBrowsing.AddCommand}" />
              </Grid>

              <TextBlock Text="{Binding Settings.WebBrowsing.Status}" FontSize="12"
                         Foreground="#FF3C4A47" TextWrapping="Wrap"
                         IsVisible="{Binding Settings.WebBrowsing.HasStatus}" />
            </StackPanel>
          </ScrollViewer>

          <!-- Model Configuration: the first real settings form -->
          <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding Settings.ShowModelConfiguration}">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding Settings.Model.PrimaryHeader}" FontSize="16.5" FontWeight="SemiBold"
                         Foreground="#FF3C4A47" />
              <ItemsControl ItemsSource="{Binding Settings.Model.Fields}"
                            ItemTemplate="{StaticResource ModelFieldRow}" />
              <TextBlock Text="{Binding Settings.Model.CloudStatus}" FontSize="12"
                         IsVisible="{Binding Settings.Model.HasCloudStatus}"
                         Foreground="#FF6D7C79" Margin="0,4,0,0" />

              <TextBlock Text="{Binding Settings.Model.DocsNote}" FontSize="12" TextWrapping="Wrap"
                         Foreground="#FF6D7C79" />

              <Grid ColumnDefinitions="215,*" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Settings.Model.AdvancedLabel}" FontSize="13.5"
                             Foreground="#FF3C4A47" VerticalAlignment="Center" />
                  <Button Width="24" Height="22" Classes="chipGhost"
                          Command="{Binding Settings.Model.ToggleAdvancedCommand}">
                    <TextBlock Classes="glyph" Text="{Binding Settings.Model.AdvancedChevron}" FontSize="11"
                               Foreground="#FF3C4A47" />
                  </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Settings.Model.AdvancedNote}" FontSize="12"
                           TextWrapping="Wrap" Foreground="#FF6D7C79" />
              </Grid>

              <TextBlock Text="{Binding Settings.Model.LocalModelHeader}" FontSize="16.5" FontWeight="SemiBold"
                         Foreground="#FF3C4A47" Margin="0,6,0,0" />
              <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                <TextBlock Text="{Binding Settings.Model.LocalStatus}" FontSize="13" Margin="0,0,12,0"
                           Foreground="#FF2B2B32" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="chip" Margin="0,0,8,0"
                        IsEnabled="{Binding Settings.Model.IsIdle}"
                        Command="{Binding Settings.Model.CheckCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Settings.Model.CheckLabel}" FontSize="12.5" />
                    <TextBlock Classes="glyph" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="danger" Margin="0,0,14,0"
                        IsEnabled="{Binding Settings.Model.IsIdle}"
                        Content="{Binding Settings.Model.DeleteLabel}"
                        Command="{Binding Settings.Model.DeleteCommand}" />
                <TextBlock Grid.Column="3" Text="{Binding Settings.Model.LocalModelNote}" FontSize="12"
                           TextWrapping="Wrap" Foreground="#FF6D7C79" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <StackPanel Spacing="2" Grid.Column="0">
                  <TextBlock Text="{Binding Settings.Model.GpuLabel}" FontSize="13" Foreground="#FF2B2B32" />
                  <TextBlock Text="{Binding Settings.Model.GpuNoteText}" FontSize="12"
                             Foreground="#FF6D7C79" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="chip" VerticalAlignment="Center"
                        Command="{Binding Settings.Model.ToggleGpuCommand}">
                  <TextBlock Text="{Binding Settings.Model.GpuStateLabel}" FontSize="12.5" />
                </Button>
              </Grid>

              <TextBlock Text="{Binding Settings.Model.InstallNote}" FontSize="12"
                         IsVisible="{Binding Settings.Model.HasInstallNote}"
                         Foreground="#FF3C4A47" Margin="0,2,0,0" />

              <Button Classes="chipGhost" HorizontalAlignment="Left" Margin="0,6,0,0"
                      Command="{Binding Settings.Model.OpenOllamaCommand}"
                      ToolTip.Tip="{DynamicResource Settings.Model.OllamaWindowNote}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Settings.Model.OllamaLabel}" FontSize="13.5"
                             Foreground="#FF3C4A47" />
                  <TextBlock Classes="glyph" Text="&#xE70D;" FontSize="10" Foreground="#FF3C4A47"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Text="{Binding Settings.Model.OllamaNote}" FontSize="12" TextWrapping="Wrap"
                         Foreground="#FF6D7C79" />
              <Button Classes="wideAction" Content="{Binding Settings.Model.AddLabel}"
                      Command="{Binding Settings.Model.AddCommand}" Margin="0,4,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- footer -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,14,22,16">
      <Button Classes="icon" Width="30" Height="30" ToolTip.Tip="{DynamicResource Help.Title}">
        <TextBlock Classes="glyph" Text="{StaticResource GlyphHelp}" FontSize="18" />
      </Button>
      <Button Classes="icon" Width="30" Height="30" Command="{Binding ToggleSettingsCommand}"
              ToolTip.Tip="{DynamicResource Tip.Back}">
        <TextBlock Classes="glyph" Text="&#xE7A7;" FontSize="18" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
