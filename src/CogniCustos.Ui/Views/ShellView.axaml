<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:CogniCustos.Ui.ViewModels"
             xmlns:views="using:CogniCustos.Ui.Views"
             x:Class="CogniCustos.Ui.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{StaticResource AppBg}"
             ClipToBounds="True">

  <UserControl.Resources>

    <!-- one row inside a board card -->
    <DataTemplate x:Key="CardRow" x:DataType="vm:CardItem">
      <Button Classes="cardRow" Command="{Binding Command}" CommandParameter="{Binding}">
        <StackPanel Spacing="1" Margin="0,2,0,6">
          <TextBlock Text="{Binding When}" FontSize="13"
                     Foreground="{StaticResource InkFaint}" IsVisible="{Binding HasWhen}" />
          <Border Background="#FFE6F0EC" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left"
                  IsVisible="{Binding HasTag}">
            <TextBlock Text="{Binding Tag}" FontSize="10.5" Foreground="#FF3C4A47" />
          </Border>
          <TextBlock Text="{Binding Title}" FontSize="15.5"
                     Foreground="#FF45454F" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Source}" FontSize="12.5"
                     Foreground="{StaticResource InkFaint}" IsVisible="{Binding HasSource}" />
          <TextBlock Text="{Binding SourceFile}" FontSize="12.5"
                     Foreground="{StaticResource InkFaint}" IsVisible="{Binding HasSourceFile}" />
        </StackPanel>
      </Button>
    </DataTemplate>
    <!-- one run of reminder items; the marquee uses two (original + copy) -->
    <DataTemplate x:Key="TickerRunTemplate" x:DataType="vm:ReminderItem">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Text}" FontSize="17" VerticalAlignment="Center"
                   Classes="ticker" Classes.urgent="{Binding Urgent}" />
        <TextBlock Text="   ·   " FontSize="17" VerticalAlignment="Center"
                   Foreground="{StaticResource InkFaint}" />
      </StackPanel>
    </DataTemplate>

    <!-- one board card: header (icon / page-up / right-aligned title) / scrolling body / footer -->
    <DataTemplate x:Key="CardTemplate" x:DataType="vm:CardViewModel">
      <Border Name="CardRoot" Classes="card"
              Classes.pink="{Binding IsPink}"
              Classes.olive="{Binding IsOlive}"
              Height="300">
        <Grid RowDefinitions="Auto,*,Auto">

          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="glyph" Text="{Binding Glyph}" FontSize="30"
                       Foreground="{StaticResource Ink}" />
            <Button Grid.Column="2" Name="CardScrollUp" Classes="icon" Width="22" Height="22" Margin="0,0,6,0"
                    Click="OnCardScrollUp" ToolTip.Tip="{DynamicResource Tip.ScrollUp}">
              <TextBlock Classes="glyph" Text="{StaticResource GlyphChevronUp}" FontSize="15"
                         Foreground="{StaticResource InkSoft}" />
            </Button>
            <Button Grid.Column="3" Classes="cardDate" Content="{Binding Title}"
                    Command="{Binding OpenDateCommand}" IsVisible="{Binding ShowDateButton}"
                    ToolTip.Tip="{DynamicResource Calendar.Open}" />
            <TextBlock Grid.Column="3" Text="{Binding Title}" Width="104"
                       TextAlignment="Right" TextWrapping="Wrap"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                       IsVisible="{Binding !ShowDateButton}" />
          </Grid>

          <Grid Grid.Row="1" Margin="0,10,0,0">
            <ScrollViewer Name="CardScrollViewer" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="OnCardScrollChanged" Loaded="OnCardScrollLoaded"
                          LayoutUpdated="OnCardScrollLayout"
                          IsVisible="{Binding HasRows}">
              <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardRow}"
                            VerticalAlignment="Top" />
            </ScrollViewer>
            <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                       Classes="muted" FontSize="14.5" VerticalAlignment="Top" />
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Button Grid.Column="0" Name="CardScrollDown" Classes="icon" Width="32" Height="30"
                    HorizontalAlignment="Center" Click="OnCardScrollDown"
                    ToolTip.Tip="{DynamicResource Tip.ScrollDown}">
              <TextBlock Classes="glyph" Text="{StaticResource GlyphChevronDown}" FontSize="14"
                         Foreground="{StaticResource InkSoft}" />
            </Button>
            <Button Grid.Column="1" Classes="icon" Width="24" Height="24"
                    IsVisible="{Binding ShowAdd}" IsEnabled="{Binding CanAdd}"
                    Command="{Binding AddCommand}" ToolTip.Tip="{DynamicResource Tip.Add}">
              <Border Width="26" Height="26" CornerRadius="13" BorderThickness="1.4"
                      BorderBrush="{StaticResource InkFaint}">
                <TextBlock Classes="glyph" Text="{StaticResource GlyphPlus}" FontSize="12" />
              </Border>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <Grid ColumnDefinitions="187,*,88">

    <!-- ============================ LEFT SIDEBAR ============================ -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
      <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- logo -->
        <Border Grid.Row="0" Width="72" Height="72" CornerRadius="36" BorderThickness="3"
                BorderBrush="{StaticResource Ink}" Margin="22,18,0,0" HorizontalAlignment="Left">
          <TextBlock Classes="glyph" Text="{StaticResource GlyphPerson}" FontSize="40"
                     Foreground="{StaticResource Ink}" />
        </Border>

        <!-- reasoning record caption: the entry of the record list -->
        <Button Grid.Row="2" Classes="rowLink" Margin="8,0,6,40"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Command="{Binding Reasoning.OpenListCommand}"
                ToolTip.Tip="{DynamicResource Reasoning.Title}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="glyph" Text="{StaticResource GlyphDoc}" FontSize="17"
                       Foreground="{StaticResource InkSoft}" />
            <TextBlock Text="{DynamicResource Reasoning.Title}" FontSize="13.5"
                       Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- reasoning panel -->
        <Border Grid.Row="3" Height="165" Background="{StaticResource Surface}">
          <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto" Margin="12,14,10,12">
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Top">
              <TextBlock Text="{DynamicResource Reasoning.Thinking}" FontSize="14.5"
                         IsVisible="{Binding !HasToast}" TextWrapping="Wrap" Width="170"
                         Foreground="{StaticResource InkSoft}" />
              <TextBlock Text="{Binding Toast}" FontSize="14.5" IsVisible="{Binding HasToast}"
                         TextWrapping="Wrap" Width="170"
                         Foreground="{StaticResource InkSoft}" />
              <TextBlock Classes="glyph" Text="{StaticResource GlyphChat}" FontSize="15.5"
                         IsVisible="{Binding !HasToast}" Foreground="{StaticResource InkSoft}" />
            </StackPanel>
            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="icon"
                    Width="24" Height="24" HorizontalAlignment="Right"
                    Command="{Binding Reasoning.ToggleTrajectoryCommand}"
                    ToolTip.Tip="{DynamicResource Reasoning.Trajectory}">
              <TextBlock Classes="glyph" Text="{Binding Reasoning.TrajectoryChevron}" FontSize="13" />
            </Button>
          </Grid>
        </Border>

      </Grid>
    </Border>

    <!-- ============================ CONTENT ============================ -->
    <Grid Grid.Column="1" ClipToBounds="True">

      <Grid RowDefinitions="76,*,140">
        <Grid.Effect>
          <BlurEffect Radius="{Binding HomeBlurRadius}" />
        </Grid.Effect>


        <!-- top bar: brand chip + today's reminder line + home + sound -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="27,0,39,0">

          <Border Grid.Column="0" Classes="chip" Width="181" VerticalAlignment="Center">
            <TextBlock Text="CogniCustos" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
          </Border>

          <!-- the real reminder pill is an overlay (it must sit above the click-outside
               backdrop so it can toggle its own drawer); this keeps the row laid out -->
          <Border Grid.Column="1" Width="559" Height="36" Margin="38,0,0,0" />

          <Button Grid.Column="3" Classes="link" FontSize="17.5" Content="{DynamicResource App.Home}"
                  Command="{Binding GoHomeCommand}" VerticalAlignment="Center" Margin="0,0,34,0" />

          <Button Grid.Column="4" Classes="icon"
                  VerticalAlignment="Center" Margin="14,0,0,0" ToolTip.Tip="{DynamicResource Tip.Sound}">
            <TextBlock Classes="glyph" Text="{StaticResource GlyphVolume}" FontSize="18"
                       Foreground="{StaticResource Ink}" />
          </Button>
        </Grid>

        <!-- board -->
        <Grid Grid.Row="1" Margin="27,9,0,0" VerticalAlignment="Top">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="45" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- input -->
        <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,-88,19">
          <StackPanel HorizontalAlignment="Center" Spacing="4">
            <Border Width="220" Height="48" CornerRadius="24"
                    Background="#FFE9E9EE">
              <Grid ColumnDefinitions="Auto,*" Margin="6,0,14,0">
                <!-- the microphone: one press, one utterance, text lands in the box -->
                <Button Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                        Background="{Binding MicBackground}" BorderThickness="0"
                        Command="{Binding MicCommand}" ToolTip.Tip="{Binding MicTooltip}">
                  <TextBlock Classes="glyph" Text="{Binding MicGlyph}" FontSize="17"
                             Foreground="{StaticResource InkSoft}" />
                </Button>
                <TextBox x:Name="InputBox" Grid.Column="1" Classes="pill" Margin="8,0,0,0"
                         PlaceholderText="{DynamicResource App.EnterText}" Text="{Binding InputText}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SubmitInputCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </Grid>
            </Border>

            <!-- what the microphone is doing, or why it refused -->
            <TextBlock Text="{Binding VoiceHint}" IsVisible="{Binding HasVoiceHint}"
                       FontSize="10.5" Foreground="#FF6D7C79" HorizontalAlignment="Center"
                       MaxWidth="420" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- click-outside catcher: covers the whole content area, so a click anywhere
           outside the pill and its drawer closes it. The pill is drawn above this. -->
      <Border Name="OverlayBackdrop" ZIndex="5" Background="Transparent"
              IsVisible="{Binding IsBackdropVisible}"
              PointerPressed="OnBackdropPressed" />

      <!-- reminder pill: drawn above the backdrop so it can toggle its own drawer -->
      <Button Name="ReminderPill" ZIndex="6" Classes="pill" Width="559" Height="36"
              Margin="246,20,0,0"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Command="{Binding Today.ToggleListCommand}"
              ToolTip.Tip="{DynamicResource Today.Title}">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <TextBlock Grid.Column="0" Classes="glyph" Text="{StaticResource GlyphAlarm}"
                     FontSize="22" Foreground="#FFE0A23C" Margin="4,0,10,0" />
          <Border x:Name="TickerClip" Grid.Column="1" ClipToBounds="True" Height="24" VerticalAlignment="Center">
            <Grid>
              <StackPanel x:Name="TickerRow" Orientation="Horizontal">
                <ItemsControl x:Name="TickerRuns" ItemsSource="{Binding Today.Items}"
                              ItemTemplate="{StaticResource TickerRunTemplate}" />
                <ItemsControl x:Name="TickerCopyRuns" ItemsSource="{Binding Today.Items}"
                              ItemTemplate="{StaticResource TickerRunTemplate}"
                              Margin="48,0,0,0" IsVisible="False" />
              </StackPanel>
              <TextBlock Text="{DynamicResource Today.Empty}" FontSize="16"
                         Foreground="{StaticResource InkFaint}"
                         IsVisible="{Binding Today.IsEmpty}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <TextBlock Grid.Column="2" Classes="glyph" Text="{Binding Today.ListChevron}"
                     FontSize="12" Foreground="{StaticResource InkFaint}" Margin="8,0,0,0" />
        </Grid>
      </Button>

      <!-- reminder drawer: height follows the rows, capped at 274, virtualised list.
           Background opacity is a single token: ReminderDrawerBackground. -->
      <Border Name="ReminderDrawer" ZIndex="6" Width="507" MaxHeight="274"
              Margin="272,60,0,0"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              CornerRadius="10" Background="{DynamicResource ReminderDrawerBackground}"
              BorderBrush="{StaticResource Line}" BorderThickness="1"
              BoxShadow="0 12 34 0 #1F000000" ClipToBounds="True"
              IsVisible="{Binding Today.IsListOpen}">
        <Grid>
          <ListBox x:Name="ReminderList" Classes="reminder"
                   ItemsSource="{Binding Today.Items}"
                   MaxHeight="272"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReminderItem">
                <TextBlock Text="{Binding Text}" FontSize="15.5" TextWrapping="Wrap"
                           Classes="ticker" Classes.urgent="{Binding Urgent}" Margin="16,12" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{DynamicResource Today.Empty}" IsVisible="{Binding Today.IsEmpty}"
                     FontSize="15.5" Foreground="{StaticResource InkFaint}" Margin="16,12" />
        </Grid>
      </Border>

      <!-- help panel -->
      <Border ZIndex="7" Width="300" Height="180" CornerRadius="14" Background="{StaticResource Surface}"
              BoxShadow="0 8 26 0 #16000000"
              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
              IsVisible="{Binding HelpOpen}">
        <Grid RowDefinitions="Auto,*" Margin="16,14">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Classes="glyph" Text="{StaticResource GlyphHelp}" FontSize="18" />
            <TextBlock Grid.Column="1" Text="{DynamicResource Help.Title}" FontSize="17" FontWeight="SemiBold"
                       Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Ink}" />
            <Button Grid.Column="2" Classes="icon" Width="24" Height="24"
                    Command="{Binding ToggleHelpCommand}">
              <TextBlock Classes="glyph" Text="&#xE711;" FontSize="13" />
            </Button>
          </Grid>
          <TextBlock Grid.Row="1" Text="{DynamicResource Help.Placeholder}" FontSize="15"
                     Foreground="{StaticResource InkFaint}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </Grid>
      </Border>

    </Grid>

      <!-- ===== drawer stack: layer 1 (icon grid) + layer 2 (future area) =====
           The stack covers the whole content area including the top bar; home blurs
           and dims behind it. Clicking the page closes one layer at a time. -->

      <Border Name="DrawerScrim" Grid.Column="1" ZIndex="8" Background="Transparent"
              IsVisible="{Binding IsScrimVisible}"
              PointerPressed="OnScrimPressed">
        <Border Background="Black" Opacity="{Binding HomeDimOpacity}" />
      </Border>

      <Border Name="MenuDrawer" Grid.Column="1" ZIndex="9"
              Width="{Binding MenuWidth}"
              HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Background="{StaticResource RailBg}"
              BorderBrush="#FFDCD9E8" BorderThickness="1,0,0,0"
              ClipToBounds="True"
              Opacity="{Binding MenuOpacity}"
              IsHitTestVisible="{Binding MenuHitTest}">
        <Border.RenderTransform>
          <TranslateTransform X="{Binding MenuOffset}">
            <TranslateTransform.Transitions>
              <Transitions>
                <DoubleTransition Property="X" Duration="0:0:0.24" Easing="CubicEaseOut" />
              </Transitions>
            </TranslateTransform.Transitions>
          </TranslateTransform>
        </Border.RenderTransform>
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
          </Transitions>
        </Border.Transitions>

        <Grid RowDefinitions="*,Auto">
          <Grid Grid.Row="0" Margin="16,26,16,0" VerticalAlignment="Top"
                ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
              <Button Grid.Row="0" Grid.Column="0" Classes="tile" Width="100" Height="112"
                      Margin="0,0,0,18" HorizontalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Tile.Knowledge}">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="glyph" Text="{StaticResource GlyphKnowledge}" FontSize="30" HorizontalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Tile.Knowledge}" FontSize="11"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center"
                             Width="86" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Row="0" Grid.Column="1" Classes="tile" Width="100" Height="112"
                      Margin="0,0,0,18" HorizontalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Tile.DataBase}">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                  <Path Width="24" Height="24" Data="{StaticResource GeoDataBase}" Stroke="{StaticResource InkSoft}"
                        StrokeThickness="1.2" Fill="Transparent" HorizontalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Tile.DataBase}" FontSize="11"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center"
                             Width="86" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Row="0" Grid.Column="2" Classes="tile" Width="100" Height="112"
                      Margin="0,0,0,18" HorizontalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Tile.Sandbox}">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="glyph" Text="{StaticResource GlyphSandbox}" FontSize="30" HorizontalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Tile.Sandbox}" FontSize="11"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center"
                             Width="86" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Row="1" Grid.Column="0" Classes="tile" Width="100" Height="112"
                      Margin="0,0,0,18" HorizontalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Tile.AddFiles}">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="glyph" Text="{StaticResource GlyphAttach}" FontSize="30" HorizontalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Tile.AddFiles}" FontSize="11"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center"
                             Width="86" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Row="1" Grid.Column="1" Classes="tile" Width="100" Height="112"
                      Margin="0,0,0,18" HorizontalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Tile.AddAddress}">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="glyph" Text="{StaticResource GlyphFolder}" FontSize="30" HorizontalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Tile.AddAddress}" FontSize="11"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center"
                             Width="86" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Row="2" Grid.Column="0" Classes="tile" Width="100" Height="112"
                      Margin="0,0,0,18" HorizontalAlignment="Center"
                      Command="{Binding CheckMailCommand}"
                      ToolTip.Tip="{DynamicResource Tile.CheckMail}">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="glyph" Text="{StaticResource GlyphMail}" FontSize="30" HorizontalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Tile.CheckMail}" FontSize="11"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center"
                             Width="86" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Row="2" Grid.Column="1" Classes="tile" Width="100" Height="112"
                      Margin="0,0,0,18" HorizontalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Tile.SearchGraphical}">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                  <Grid Width="30" Height="24" HorizontalAlignment="Center">
                    <TextBlock Classes="glyph" Text="{StaticResource GlyphPerson}" FontSize="24" HorizontalAlignment="Left" />
                    <TextBlock Classes="glyph" Text="{StaticResource GlyphSearch}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                  </Grid>
                  <TextBlock Text="{DynamicResource Tile.SearchGraphical}" FontSize="11"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center"
                             Width="86" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>

              <!-- third row, right of mail + chat search: read a web page -->
              <Button Grid.Row="2" Grid.Column="2" Classes="tile" Width="100" Height="112"
                      Margin="0,0,0,18" HorizontalAlignment="Center"
                      Command="{Binding OpenWebReadingCommand}"
                      ToolTip.Tip="{DynamicResource Tile.ReadWeb}">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="glyph" Text="{StaticResource GlyphGlobe}" FontSize="30" HorizontalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Tile.ReadWeb}" FontSize="11"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center"
                             Width="86" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <!-- one extra row at the bottom: open a document and have it explained -->
              <Button Grid.Row="3" Grid.Column="0" Classes="tile" Width="100" Height="112"
                      Margin="0,0,0,18" HorizontalAlignment="Center"
                      Name="ReadFileTile" Click="OnReadFileClicked"
                      ToolTip.Tip="{DynamicResource Tile.ReadFile}">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="glyph" Text="&#xE736;" FontSize="30" HorizontalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Tile.ReadFile}" FontSize="11"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center"
                             Width="86" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
          </Grid>

          <!-- footer: open/close the second layer, then the calendar placeholder -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6"
                      Margin="16,0,0,18" VerticalAlignment="Bottom">
            <Button Classes="icon" Width="30" Height="30" Command="{Binding ExpandDrawerCommand}"
                    ToolTip.Tip="{DynamicResource Tip.Expand}">
              <TextBlock Classes="glyph" FontSize="17" Text="{Binding ExpandGlyph}" />
            </Button>
            <Button Classes="icon" Width="30" Height="30" ToolTip.Tip="{DynamicResource Tip.Calendar}">
              <TextBlock Classes="glyph" Text="{StaticResource GlyphCalendar}" FontSize="18" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- layer 2: another drawer, pinned to the left edge of layer 1 (390) -->
      <Border Name="FutureDrawer" Grid.Column="1" ZIndex="9"
              Width="{Binding FutureWidth}"
              Margin="0,0,390,0"
              HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Background="{StaticResource Surface}"
              BorderBrush="#FFDCD9E8" BorderThickness="1,0,0,0"
              ClipToBounds="True"
              Opacity="{Binding FutureOpacity}"
              IsHitTestVisible="{Binding FutureHitTest}">
        <Border.RenderTransform>
          <TranslateTransform X="{Binding FutureOffset}">
            <TranslateTransform.Transitions>
              <Transitions>
                <DoubleTransition Property="X" Duration="0:0:0.24" Easing="CubicEaseOut" />
              </Transitions>
            </TranslateTransform.Transitions>
          </TranslateTransform>
        </Border.RenderTransform>
        <TextBlock Text="{DynamicResource Drawer.FutureArea}"
                   FontSize="32" FontWeight="Thin"
                   Foreground="#FF4B4B58"
                   TextWrapping="Wrap" Width="232"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   LineHeight="40" />
      </Border>

    <!-- ============================ RIGHT RAIL ============================ -->
    <Border Grid.Column="2" ZIndex="15" Background="{StaticResource RailBg}">
      <Grid RowDefinitions="76,*,Auto,30">

        <views:LanguagePicker Grid.Row="0"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel Grid.Row="2" Spacing="28" HorizontalAlignment="Center">
          <Button Classes="icon" Classes.open="{Binding IsMenuActive}"
                  Command="{Binding ToggleDrawerCommand}" ToolTip.Tip="{DynamicResource Tip.Menu}">
            <TextBlock Classes="glyph" Text="{StaticResource GlyphMenu}" FontSize="30"
                       Foreground="{StaticResource Ink}" />
          </Button>
          <Button Classes="icon" Classes.open="{Binding IsHelpActive}"
                  Command="{Binding ToggleHelpCommand}" ToolTip.Tip="{DynamicResource Tip.Help}">
            <TextBlock Classes="glyph" Text="{StaticResource GlyphHelp}" FontSize="30"
                       Foreground="{StaticResource Ink}" />
          </Button>
          <Button Classes="icon" Classes.open="{Binding IsSettingsActive}"
                  Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="{DynamicResource Tip.Settings}">
            <TextBlock Classes="glyph" Text="{StaticResource GlyphSettings}" FontSize="30"
                       Foreground="{StaticResource Ink}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ SETTINGS PAGE ============================ -->
    <views:SettingsPage ZIndex="20" Grid.ColumnSpan="3" IsVisible="{Binding SettingsOpen}" />

    <!-- ============================ POINT-READ READER ============================ -->
    <!-- a full-canvas page like the settings page: the document, the box, the answer -->
    <views:ReaderPage ZIndex="21" Grid.ColumnSpan="3" IsVisible="{Binding Reader.IsOpen}" />

    <!-- ============ REASONING RECORD (list) and THOUGHT TRAJECTORY (trace) ============ -->
    <!-- two independent panels, two independent entries; neither dims the page -->
    <Border Name="ReasoningScrim" Grid.ColumnSpan="3" ZIndex="11" Background="Transparent"
            IsVisible="{Binding Reasoning.IsAnyOpen}"
            PointerPressed="OnReasoningScrimPressed" />

    <Border Grid.ColumnSpan="3" ZIndex="12" Width="617" Height="600"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="211,104,0,0"
            Background="{StaticResource Surface}" CornerRadius="4"
            BoxShadow="0 18 44 0 #26000000"
            IsVisible="{Binding Reasoning.IsListOpen}">
      <Grid RowDefinitions="Auto,*" Margin="26,18,18,18">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Grid.Column="0" Text="{Binding Reasoning.ListTitle}" FontSize="23"
                     Foreground="{StaticResource Ink}" />
          <Button Grid.Column="1" Classes="roundClose" Width="30" Height="30"
                  Command="{Binding Reasoning.CloseCommand}"
                  ToolTip.Tip="{DynamicResource Tip.Close}">
            <TextBlock Classes="glyph" Text="{StaticResource GlyphClose}" FontSize="13"
                       Foreground="{StaticResource Ink}" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Reasoning.Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ReasoningGroup">
                <StackPanel>
                  <Button Classes="reasonHeader" Command="{Binding ToggleCommand}">
                    <Grid ColumnDefinitions="*,Auto" Height="34">
                      <TextBlock Grid.Column="0" Text="{Binding Header}" FontSize="17"
                                 Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="glyph" Text="{Binding Chevron}"
                                 FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <ItemsControl ItemsSource="{Binding Records}" IsVisible="{Binding IsExpanded}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ReasoningRecord">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,8">
                          <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="13"
                                     Width="128" Foreground="#FF45454F" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                     TextWrapping="Wrap" Foreground="#FF45454F" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.ColumnSpan="3" ZIndex="12" Width="823" Height="468"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="211,242,0,0"
            Background="{StaticResource Surface}" CornerRadius="4"
            BoxShadow="0 18 44 0 #26000000"
            IsVisible="{Binding Reasoning.IsTrajectoryOpen}">
      <Grid RowDefinitions="Auto,*" Margin="22,16,16,16">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Text="{Binding Reasoning.TrajectoryTitle}" FontSize="23"
                     Foreground="{StaticResource Ink}" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Text="{Binding Reasoning.TrajectoryRecordTitle}"
                     FontSize="14" TextWrapping="Wrap" Margin="14,4,14,0"
                     Foreground="{StaticResource Ink}" />
          <Button Grid.Column="2" Classes="roundClose" Width="32" Height="32"
                  Command="{Binding Reasoning.CloseCommand}"
                  ToolTip.Tip="{DynamicResource Tip.Close}">
            <TextBlock Classes="glyph" Text="{StaticResource GlyphClose}" FontSize="14"
                       Foreground="{StaticResource Ink}" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <TextBlock Text="{Binding Reasoning.TrajectoryText}"
                     FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                     LineHeight="17" TextWrapping="Wrap" Foreground="#FF2B2B32" />
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ============================ DIALOG ============================ -->
    <!-- one surface for: incoming decision, ignore confirm, composer, note edit -->
    <Grid Grid.ColumnSpan="3" ZIndex="40" IsVisible="{Binding Dialog.IsOpen}">
      <Border Background="#33000000" />
      <Border Width="560" Background="{StaticResource Surface}" CornerRadius="16" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 24 60 0 #33000000">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding Dialog.Title}" FontSize="19" FontWeight="SemiBold"
                     Foreground="{StaticResource Ink}" />
          <TextBlock Text="{Binding Dialog.Body}" FontSize="14.5" TextWrapping="Wrap"
                     Foreground="{StaticResource InkSoft}" />

          <TextBox Text="{Binding Dialog.EditorText}" IsVisible="{Binding Dialog.ShowEditor}"
                   AcceptsReturn="True" Height="140" TextWrapping="Wrap" FontSize="15"
                   Background="#FFF4F4F8" BorderThickness="0" Padding="12" CornerRadius="10" />

          <!-- the bottom composer, lifted into the dialog -->
          <Border IsVisible="{Binding Dialog.ShowComposer}" Background="#FFE9E9EE"
                  CornerRadius="14" Padding="6">
            <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                      Background="#FFCFCFD8" VerticalAlignment="Center">
                <TextBlock Classes="glyph" Text="{StaticResource GlyphMic}" FontSize="16"
                           Foreground="{StaticResource InkSoft}" />
              </Border>
              <TextBox Grid.Column="1" Text="{Binding Dialog.ComposerText}" Margin="8,0,0,0"
                       Background="Transparent" BorderThickness="0" FontSize="15"
                       PlaceholderText="{Binding Dialog.ComposerPrompt}" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding Dialog.Buttons}" HorizontalAlignment="Right">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DialogButton">
                <Button Classes="dialog" Classes.primary="{Binding Primary}"
                        Content="{Binding Text}" Command="{Binding Command}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============================ CALENDAR WINDOW ============================ -->
    <!-- a floating child window: positioned in a Canvas so the title bar can drag it -->
    <Canvas Grid.ColumnSpan="3" ZIndex="30" IsVisible="{Binding Calendar.IsVisible}">
      <views:CalendarWindow Canvas.Left="{Binding Calendar.X}" Canvas.Top="{Binding Calendar.Y}" />
    </Canvas>

  </Grid>
</UserControl>
