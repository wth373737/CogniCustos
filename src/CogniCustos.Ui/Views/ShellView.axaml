<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:CogniCustos.Ui.ViewModels"
             xmlns:views="using:CogniCustos.Ui.Views"
             x:Class="CogniCustos.Ui.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{StaticResource AppBg}"
             ClipToBounds="True">

  <UserControl.Resources>

    <!-- one row inside a board card -->
    <DataTemplate x:Key="CardRow" x:DataType="vm:CardItem">
      <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
        <TextBlock Grid.Column="0"
                   Text="{Binding Meta}"
                   FontSize="13.5"
                   Foreground="{StaticResource InkFaint}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   IsVisible="{Binding Meta, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding Text}"
                   FontSize="15.5"
                   Foreground="#FF45454F"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>

    <!-- one board card: header (icon / collapse / right-aligned title) / body / footer -->
    <DataTemplate x:Key="CardTemplate" x:DataType="vm:CardViewModel">
      <Border Classes="card"
              Classes.pink="{Binding IsPink}"
              Classes.olive="{Binding IsOlive}"
              Height="{Binding CardHeight}">
        <Grid RowDefinitions="Auto,*,Auto">

          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="glyph" Text="{Binding Glyph}" FontSize="30"
                       Foreground="{StaticResource Ink}" />
            <Button Grid.Column="2" Classes="icon" Width="22" Height="22" Margin="0,0,6,0"
                    Command="{Binding ToggleCollapseCommand}" ToolTip.Tip="{DynamicResource Tip.Collapse}">
              <TextBlock Classes="glyph" Text="{Binding CollapseGlyph}" FontSize="14.5"
                         Foreground="{StaticResource InkFaint}" />
            </Button>
            <TextBlock Grid.Column="3" Text="{Binding Title}" Width="104"
                       TextAlignment="Right" TextWrapping="Wrap"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
          </Grid>

          <Grid Grid.Row="1" IsVisible="{Binding IsExpanded}" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardRow}"
                          VerticalAlignment="Top" IsVisible="{Binding HasRows}" />
            <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                       Classes="muted" FontSize="14.5" VerticalAlignment="Top" />
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Button Grid.Column="0" Classes="icon" Width="30" Height="30" HorizontalAlignment="Center"
                    ToolTip.Tip="{DynamicResource Tip.OpenList}">
              <TextBlock Classes="glyph" Text="{StaticResource GlyphChevronDown}" FontSize="13" />
            </Button>
            <Button Grid.Column="1" Classes="icon" Width="24" Height="24"
                    IsVisible="{Binding ShowAdd}" IsEnabled="{Binding CanAdd}"
                    Command="{Binding AddCommand}" ToolTip.Tip="{DynamicResource Tip.Add}">
              <Border Width="26" Height="26" CornerRadius="13" BorderThickness="1.4"
                      BorderBrush="{StaticResource InkFaint}">
                <TextBlock Classes="glyph" Text="{StaticResource GlyphPlus}" FontSize="12" />
              </Border>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <Grid ColumnDefinitions="187,*,88">

    <!-- ============================ LEFT SIDEBAR ============================ -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
      <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- logo -->
        <Border Grid.Row="0" Width="72" Height="72" CornerRadius="36" BorderThickness="3"
                BorderBrush="{StaticResource Ink}" Margin="22,18,0,0" HorizontalAlignment="Left">
          <TextBlock Classes="glyph" Text="{StaticResource GlyphPerson}" FontSize="40"
                     Foreground="{StaticResource Ink}" />
        </Border>

        <!-- reasoning record caption -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="12,0,10,44">
          <TextBlock Classes="glyph" Text="{StaticResource GlyphDoc}" FontSize="17"
                     Foreground="{StaticResource InkSoft}" />
          <TextBlock Text="{DynamicResource Reasoning.Title}" FontSize="13.5"
                     Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- reasoning panel -->
        <Border Grid.Row="3" Height="165" Background="{StaticResource Surface}">
          <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto" Margin="12,14,10,12">
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Top">
              <TextBlock Text="{DynamicResource Reasoning.Thinking}" FontSize="14.5"
                         IsVisible="{Binding !HasToast}" TextWrapping="Wrap" Width="170"
                         Foreground="{StaticResource InkSoft}" />
              <TextBlock Text="{Binding Toast}" FontSize="14.5" IsVisible="{Binding HasToast}"
                         TextWrapping="Wrap" Width="170"
                         Foreground="{StaticResource InkSoft}" />
              <TextBlock Classes="glyph" Text="{StaticResource GlyphChat}" FontSize="15.5"
                         IsVisible="{Binding !HasToast}" Foreground="{StaticResource InkSoft}" />
            </StackPanel>
            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="icon"
                    Width="24" Height="24" HorizontalAlignment="Right"
                    ToolTip.Tip="{DynamicResource Tip.ReasoningRecord}">
              <TextBlock Classes="glyph" Text="{StaticResource GlyphChevronRight}" FontSize="13" />
            </Button>
          </Grid>
        </Border>

      </Grid>
    </Border>

    <!-- ============================ CONTENT ============================ -->
    <Grid Grid.Column="1" ClipToBounds="True">

      <Grid RowDefinitions="76,*,140">

        <!-- top bar: brand chip + today's reminder line + home + sound -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="27,0,39,0">

          <Border Grid.Column="0" Classes="chip" Width="181" VerticalAlignment="Center">
            <TextBlock Text="CogniCustos" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
          </Border>

          <Button Grid.Column="1" Classes="pill" Width="559" Margin="38,0,0,0"
                  VerticalAlignment="Center"
                  Command="{Binding Today.ToggleListCommand}"
                  ToolTip.Tip="{DynamicResource Today.Title}">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
              <TextBlock Grid.Column="0" Classes="glyph" Text="{StaticResource GlyphAlarm}"
                         FontSize="22" Foreground="#FFE0A23C" Margin="4,0,10,0" />
              <Border x:Name="TickerClip" Grid.Column="1" ClipToBounds="True" Height="22" VerticalAlignment="Center">
                <Grid>
                  <StackPanel x:Name="TickerRow" Orientation="Horizontal">
                    <TextBlock x:Name="TickerText" Text="{Binding Today.Line}" FontSize="17"
                               Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TickerCopy" Text="{Binding Today.Line}" FontSize="17" Margin="48,0,0,0"
                               IsVisible="False"
                               Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{DynamicResource Today.Empty}" FontSize="16"
                             Foreground="{StaticResource InkFaint}"
                             IsVisible="{Binding Today.IsEmpty}" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <TextBlock Grid.Column="2" Classes="glyph" Text="{Binding Today.ListChevron}"
                         FontSize="12" Foreground="{StaticResource InkFaint}" Margin="8,0,0,0" />
            </Grid>
          </Button>

          <Button Grid.Column="3" Classes="link" FontSize="17.5" Content="{DynamicResource App.Home}"
                  Command="{Binding GoHomeCommand}" VerticalAlignment="Center" Margin="0,0,34,0" />

          <Button Grid.Column="4" Classes="icon" Command="{Binding ToggleLanguageCommand}"
                  VerticalAlignment="Center" Margin="14,0,0,0" ToolTip.Tip="{DynamicResource Tip.Sound}">
            <TextBlock Classes="glyph" Text="{StaticResource GlyphVolume}" FontSize="18"
                       Foreground="{StaticResource Ink}" />
          </Button>
        </Grid>

        <!-- board -->
        <Grid Grid.Row="1" Margin="27,9,0,0" VerticalAlignment="Top">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="45" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- input -->
        <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,-88,19">
          <Border Width="220" Height="48" CornerRadius="24"
                  Background="#FFE9E9EE"
                  HorizontalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" Margin="6,0,14,0">
              <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                      Background="#FFCFCFD8" VerticalAlignment="Center">
                <TextBlock Classes="glyph" Text="{StaticResource GlyphMic}" FontSize="17"
                           Foreground="{StaticResource InkSoft}" />
              </Border>
              <TextBox x:Name="InputBox" Grid.Column="1" Classes="pill" Margin="8,0,0,0"
                       PlaceholderText="{DynamicResource App.EnterText}" Text="{Binding InputText}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SubmitInputCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- click-outside catcher (below the top bar, so the reminder pill stays clickable) -->
      <Border ZIndex="5" Background="Transparent" Margin="0,76,0,0"
              IsVisible="{Binding IsBackdropVisible}"
              PointerPressed="OnBackdropPressed" />

      <!-- today's reminder list, opening under the pill -->
      <Border ZIndex="6" Width="430" MaxHeight="260" Margin="246,62,0,0"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              CornerRadius="12" Background="{StaticResource Surface}"
              BorderBrush="{StaticResource Line}" BorderThickness="1"
              BoxShadow="0 10 30 0 #1A000000" ClipToBounds="True"
              IsVisible="{Binding Today.IsListOpen}">
        <Grid RowDefinitions="Auto,*" Margin="14,10,14,10">
          <TextBlock Grid.Row="0" Text="{DynamicResource Today.Title}" FontSize="14.5"
                     FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <Grid>
              <ItemsControl ItemsSource="{Binding Today.Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <TextBlock Text="{Binding}" FontSize="15.5" Margin="0,3"
                               Foreground="#FF45454F" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{DynamicResource Today.Empty}" IsVisible="{Binding Today.IsEmpty}"
                         FontSize="15.5" Foreground="{StaticResource InkFaint}" />
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- drawer (menu + reserved future area) -->
      <Border Name="DrawerPanel" ZIndex="7"
              Width="{Binding DrawerWidth}"
              Margin="0,76,0,0"
              HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Background="{StaticResource DrawerBg}"
              BorderBrush="#FFE2E0EE" BorderThickness="1,0,0,0"
              ClipToBounds="True"
              Opacity="{Binding DrawerOpacity}"
              IsHitTestVisible="{Binding DrawerHitTest}">
        <Border.RenderTransform>
          <TranslateTransform X="{Binding DrawerOffset}">
            <TranslateTransform.Transitions>
              <Transitions>
                <DoubleTransition Property="X" Duration="0:0:0.24" Easing="CubicEaseOut" />
              </Transitions>
            </TranslateTransform.Transitions>
          </TranslateTransform>
        </Border.RenderTransform>
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.24" Easing="CubicEaseOut" />
            <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
          </Transitions>
        </Border.Transitions>

        <Grid Width="560" HorizontalAlignment="Right" ColumnDefinitions="352,208">
          <!-- reserved area: always laid out, faded in when the drawer expands -->
          <Border Grid.Column="0" Opacity="{Binding FutureAreaOpacity}">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
              </Transitions>
            </Border.Transitions>
            <TextBlock Text="{DynamicResource Drawer.FutureArea}"
                       FontSize="34" FontWeight="Thin"
                       Foreground="#FF4B4B58"
                       TextWrapping="Wrap" Width="240"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       LineHeight="34" />
          </Border>

          <Grid Grid.Column="1" RowDefinitions="*,Auto">

            <!-- icon grid -->
            <Grid Grid.Row="0" Margin="14,22,10,0" VerticalAlignment="Top"
                  ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto">

              <Button Grid.Row="0" Grid.Column="0" Classes="tile" ToolTip.Tip="{DynamicResource Tile.Knowledge}">
                <StackPanel Spacing="5">
                  <TextBlock Classes="glyph" Text="{StaticResource GlyphKnowledge}" FontSize="22" />
                  <TextBlock Text="{DynamicResource Tile.Knowledge}" FontSize="9.5"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center" Width="58"
                             TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Grid.Row="0" Grid.Column="1" Classes="tile" ToolTip.Tip="{DynamicResource Tile.DataBase}">
                <StackPanel Spacing="5">
                  <Path Width="18" Height="18" Data="{StaticResource GeoDataBase}"
                        Stroke="{StaticResource InkSoft}" StrokeThickness="1.2" Fill="Transparent"
                        HorizontalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Tile.DataBase}" FontSize="9.5"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center" Width="58"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Grid.Row="0" Grid.Column="2" Classes="tile" ToolTip.Tip="{DynamicResource Tile.Sandbox}">
                <StackPanel Spacing="5">
                  <TextBlock Classes="glyph" Text="{StaticResource GlyphSandbox}" FontSize="22" />
                  <TextBlock Text="{DynamicResource Tile.Sandbox}" FontSize="9.5"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center" Width="58"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Grid.Row="1" Grid.Column="0" Classes="tile" ToolTip.Tip="{DynamicResource Tile.AddFiles}">
                <StackPanel Spacing="5">
                  <TextBlock Classes="glyph" Text="{StaticResource GlyphAttach}" FontSize="22" />
                  <TextBlock Text="{DynamicResource Tile.AddFiles}" FontSize="9.5"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center" Width="58"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Grid.Row="1" Grid.Column="1" Classes="tile" ToolTip.Tip="{DynamicResource Tile.AddAddress}">
                <StackPanel Spacing="5">
                  <TextBlock Classes="glyph" Text="{StaticResource GlyphFolder}" FontSize="22" />
                  <TextBlock Text="{DynamicResource Tile.AddAddress}" FontSize="9.5"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center" Width="58"
                             TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Grid.Row="2" Grid.Column="0" Classes="tile" ToolTip.Tip="{DynamicResource Tile.CheckMail}">
                <StackPanel Spacing="5">
                  <TextBlock Classes="glyph" Text="{StaticResource GlyphMail}" FontSize="22" />
                  <TextBlock Text="{DynamicResource Tile.CheckMail}" FontSize="9.5"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center" Width="58"
                             TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Grid.Row="2" Grid.Column="1" Classes="tile" ToolTip.Tip="{DynamicResource Tile.SearchGraphical}">
                <StackPanel Spacing="5">
                  <Grid Width="22" Height="18">
                    <TextBlock Classes="glyph" Text="{StaticResource GlyphPerson}" FontSize="17"
                               HorizontalAlignment="Left" />
                    <TextBlock Classes="glyph" Text="{StaticResource GlyphSearch}" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                  </Grid>
                  <TextBlock Text="{DynamicResource Tile.SearchGraphical}" FontSize="9.5"
                             Foreground="{StaticResource InkSoft}" TextAlignment="Center" Width="58"
                             TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <!-- drawer footer: expand chevron + calendar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="10,0,0,14"
                        VerticalAlignment="Bottom">
              <Button Classes="icon" Width="26" Height="26" Command="{Binding ExpandDrawerCommand}"
                      ToolTip.Tip="{DynamicResource Tip.Expand}">
                <TextBlock Classes="glyph" FontSize="15.5" Text="{Binding ExpandGlyph}" />
              </Button>
              <Button Classes="icon" Width="26" Height="26" ToolTip.Tip="{DynamicResource Tip.Calendar}">
                <TextBlock Classes="glyph" Text="{StaticResource GlyphCalendar}" FontSize="17" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- help panel -->
      <Border ZIndex="7" Width="300" Height="180" CornerRadius="14" Background="{StaticResource Surface}"
              BoxShadow="0 8 26 0 #16000000"
              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
              IsVisible="{Binding HelpOpen}">
        <Grid RowDefinitions="Auto,*" Margin="16,14">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Classes="glyph" Text="{StaticResource GlyphHelp}" FontSize="18" />
            <TextBlock Grid.Column="1" Text="{DynamicResource Help.Title}" FontSize="17" FontWeight="SemiBold"
                       Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Ink}" />
            <Button Grid.Column="2" Classes="icon" Width="24" Height="24"
                    Command="{Binding ToggleHelpCommand}">
              <TextBlock Classes="glyph" Text="&#xE711;" FontSize="13" />
            </Button>
          </Grid>
          <TextBlock Grid.Row="1" Text="{DynamicResource Help.Placeholder}" FontSize="15"
                     Foreground="{StaticResource InkFaint}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </Grid>
      </Border>

    </Grid>

    <!-- ============================ RIGHT RAIL ============================ -->
    <Border Grid.Column="2" Background="{StaticResource RailBg}">
      <Grid RowDefinitions="76,*,Auto,30">

        <views:LanguagePicker Grid.Row="0"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel Grid.Row="2" Spacing="28" HorizontalAlignment="Center">
          <Button Classes="icon" Classes.open="{Binding IsMenuActive}"
                  Command="{Binding ToggleDrawerCommand}" ToolTip.Tip="{DynamicResource Tip.Menu}">
            <TextBlock Classes="glyph" Text="{StaticResource GlyphMenu}" FontSize="30"
                       Foreground="{StaticResource Ink}" />
          </Button>
          <Button Classes="icon" Classes.open="{Binding IsHelpActive}"
                  Command="{Binding ToggleHelpCommand}" ToolTip.Tip="{DynamicResource Tip.Help}">
            <TextBlock Classes="glyph" Text="{StaticResource GlyphHelp}" FontSize="30"
                       Foreground="{StaticResource Ink}" />
          </Button>
          <Button Classes="icon" Classes.open="{Binding IsSettingsActive}"
                  Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="{DynamicResource Tip.Settings}">
            <TextBlock Classes="glyph" Text="{StaticResource GlyphSettings}" FontSize="30"
                       Foreground="{StaticResource Ink}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ SETTINGS PAGE ============================ -->
    <views:SettingsPage ZIndex="10" Grid.ColumnSpan="3" IsVisible="{Binding SettingsOpen}" />

  </Grid>
</UserControl>
